# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value error_log "/home/tred1873/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/tred1873/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# Batas upload dinaikkan -- default hosting cuma post_max_size 10MB,
# padahal video materi bisa sampai puluhan-ratusan MB (lihat max_size
# 100MB di api/admin/upload_video.php). Ditaruh di KEDUA blok
# <IfModule> (php7_module MAUPUN lsapi_module) supaya tetap kepakai
# siapapun mesin PHP yang aktif di server ini -- yang modulnya TIDAK
# aktif otomatis dilewati begitu saja oleh Apache/LiteSpeed, tidak
# error walau ditulis dobel begini.
<IfModule php7_module>
   php_value post_max_size 150M
   php_value upload_max_filesize 110M
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value memory_limit 256M
</IfModule>
<IfModule lsapi_module>
   php_value post_max_size 150M
   php_value upload_max_filesize 110M
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value memory_limit 256M
</IfModule>

RewriteEngine On

# Jangan diutak-atik: folder api/ (endpoint PHP, sudah pakai ekstensi .php
# sendiri) & uploads/ (file upload apa adanya) -- biar aturan di bawah
# tidak ikut nyasar ke situ.
RewriteRule ^api/ - [L]
RewriteRule ^uploads/ - [L]

# 1) Kalau ada yang masih minta file dengan akhiran ".html" secara
#    eksplisit (ketik manual di address bar / link lama) -- alihkan
#    (redirect beneran, 301) ke alamat TANPA ".html", supaya address bar
#    browser langsung tampil bersih.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Kebalikannya -- kalau alamat yang diminta TIDAK ada ekstensinya
#    (mis. "/dashboard") tapi file ".html"-nya beneran ada di server,
#    tampilkan isi file itu TANPA redirect (internal saja), jadi address
#    bar tetap bersih tanpa ".html".
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]